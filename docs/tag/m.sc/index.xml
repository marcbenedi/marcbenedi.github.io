      <pubDate>Mon, 06 Jan 2020 17:36:11 +0100</pubDate>
      <guid>https://marcb.pro/project/hiwi/</guid>
      <description>&lt;!-- 

&lt;details class=&#34;toc-inpage d-print-none  &#34; open&gt;
  &lt;summary class=&#34;font-weight-bold&#34;&gt;Table of Contents&lt;/summary&gt;
  &lt;nav id=&#34;TableOfContents&#34;&gt;
  &lt;ul&gt;
    &lt;li&gt;&lt;a href=&#34;#milestones&#34;&gt;Milestones&lt;/a&gt;&lt;/li&gt;
    &lt;li&gt;&lt;a href=&#34;#other-developed-tools&#34;&gt;Other Developed Tools&lt;/a&gt;
      &lt;ul&gt;
        &lt;li&gt;&lt;a href=&#34;#ldap-triggers&#34;&gt;LDAP Triggers&lt;/a&gt;&lt;/li&gt;
        &lt;li&gt;&lt;a href=&#34;#ldap-emails&#34;&gt;LDAP Emails&lt;/a&gt;&lt;/li&gt;
      &lt;/ul&gt;
    &lt;/li&gt;
